name = "moonbitstack/moonstl"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonstl"

license = "Apache-2.0"

keywords = [
  "data-structures",
  "algorithms",
  "collections",
  "containers",
  "stl",
  "moonbit",
  "index-map",
  "index-set",
  "multimap",
  "bimap",
  "counter",
  "flat-map",
  "sorted-map",
  "range-map",
  "trie",
  "radix-tree",
  "lru-cache",
  "lfu-cache",
  "arc-cache",
  "expiring-cache",
  "memoize",
  "sorting",
  "selection",
  "bisect",
  "binary-search",
  "permutations",
  "combinations",
  "powerset",
  "partition",
  "merge",
  "ring-buffer",
  "slotmap",
  "gap-buffer",
  "bit-vector",
  "bit-set",
  "linked-list",
  "binary-heap",
  "fibonacci-heap",
  "pairing-heap",
  "min-max-heap",
  "radix-heap",
  "disjoint-set",
  "union-find",
  "segment-tree",
  "fenwick-tree",
  "interval-tree",
  "skip-list",
  "treap",
  "bloom-filter",
  "cuckoo-filter",
  "count-min-sketch",
  "hyperloglog",
  "theta-sketch",
  "t-digest",
  "string-search",
  "suffix-array",
  "suffix-automaton",
  "diff",
  "rope",
  "perfect-hash",
]

description = "Data structures and algorithms the MoonBit core library leaves out."

source = "src"

import {
  "moonbitstack/moonseed@0.2.0",
  "moonbitstack/moonast@0.3.0",
  "moonbitlang/parser@0.4.8",
  "moonbitlang/async@0.22.5",
}
