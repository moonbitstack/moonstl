name = "moonbitstack/moonstl"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonstl"

license = "Apache-2.0"

keywords = [
  "data-structures",
  "algorithms",
  "collections",
  "containers",
  "stl",
  "moonbit",
  "index-map",
  "index-set",
  "multimap",
  "bimap",
  "counter",
  "flat-map",
  "sorted-map",
  "range-map",
  "trie",
  "radix-tree",
  "lru-cache",
  "lfu-cache",
  "arc-cache",
  "expiring-cache",
  "memoize",
  "sorting",
  "selection",
  "bisect",
  "binary-search",
  "permutations",
  "combinations",
  "powerset",
  "partition",
  "merge",
]

description = "Data structures and algorithms the MoonBit core library leaves out."

source = "src"

import {
  "moonbitstack/moonseed@0.1.1",
}
