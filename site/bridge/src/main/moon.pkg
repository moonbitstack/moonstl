// The browser bridge. This package depends on moonstl, compiles to WebAssembly
// (wasm-gc), and exports two functions to the page:
//
//   run(name : String, input : String) -> String   a demo, answered as JSON
//   names() -> String                              the demo names
//
// Strings cross the boundary as JavaScript strings through the wasm `js-string`
// builtins, so the page calls into the instance with ordinary JS strings and
// needs no knowledge of the MoonBit encodings underneath.
//
// Build with:  moon build --target wasm-gc --release

pkgtype(kind: "executable")

supported_targets = "all-js+wasm-gc"

options(
  link: {
    "wasm-gc": { "exports": [ "run", "names" ], "use-js-builtin-string": true },
  },
)

import {
  "moonbitstack/moonstl/map",
  "moonbitstack/moonstl/cache",
  "moonbitstack/moonstl/heap",
  "moonbitstack/moonstl/tree",
  "moonbitstack/moonstl/sketch",
  "moonbitstack/moonstl/text",
  "moonbitstack/moonstl/phf",
  "moonbitstack/moonstl/seq",
  "moonbitstack/moonstl/algo",
  "moonbitstack/moonjson" @json,
  "moonbitlang/core/json" @cjson,
}
